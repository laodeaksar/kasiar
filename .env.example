# Salin file ini menjadi .env. Jangan kirim nilai di dalam .env melalui chat atau commit.
# Untuk Neon, gunakan connection string PostgreSQL pooled yang berakhiran sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Rahasia Better Auth: buat nilai acak panjang (minimal 32 karakter) dan isi di .env.
BETTER_AUTH_SECRET=ISI_SENDIRI_SECARA_PRIVAT

# Kredensial admin pertama yang Anda tentukan sendiri; hanya simpan di .env.
ADMIN_USERNAME=ISI_USERNAME_ADMIN
ADMIN_PASSWORD=ISI_PASSWORD_ADMIN
