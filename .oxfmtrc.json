{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "drizzle/meta/**",
    "public/manus-routes.json",
    "package-lock.json",
    "dist/**",
    "dist-ssr/**"
  ]
}
